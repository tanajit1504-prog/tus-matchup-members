rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'studentId', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches('^[0-9]{5}$')
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'teamName', 'sport', 'court', 'date', 'startTime', 'endTime',
          'currentPlayers', 'maxPlayers', 'level', 'recruiting', 'note',
          'owner', 'ownerUid', 'ownerStudentId', 'memberUids',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() >= 3
        && request.resource.data.teamName.size() <= 40
        && request.resource.data.currentPlayers is int
        && request.resource.data.maxPlayers is int
        && request.resource.data.currentPlayers >= 1
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.currentPlayers <= request.resource.data.maxPlayers
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberUids', 'currentPlayers', 'recruiting', 'updatedAt'
          ])
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.currentPlayers == resource.data.currentPlayers + 1
          && request.resource.data.currentPlayers <= resource.data.maxPlayers
          && request.resource.data.updatedAt == request.time
        )
      );

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
